# PlantAI Backend Environment Configuration
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_NAME=plant_ai

# External Botanical & AI APIs
PLANTNET_API_KEY=your_plantnet_api_key
KINDWISE_API_KEY=your_kindwise_api_key
AI_API_KEY=your_gemini_or_openai_api_key

# Thresholds & Limits (Accuracy-First)
IDENTIFICATION_CONFIDENCE_THRESHOLD=0.50
SEED_CONFIDENCE_THRESHOLD=0.70
HEALTH_CONFIDENCE_THRESHOLD=0.70
MAX_UPLOAD_SIZE=10485760
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
